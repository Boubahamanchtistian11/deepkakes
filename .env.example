# ══════════════════════════════════════════════════════
#   SENTINELLE NUMÉRIQUE — Configuration des APIs
#   Copiez ce fichier en .env et remplissez vos clés
# ══════════════════════════════════════════════════════

# ── Sightengine API (https://sightengine.com) ──────────
# Gratuit : 2 000 requêtes/mois
# Créer un compte → Dashboard → API Credentials
SIGHTENGINE_USER=your_sightengine_user
SIGHTENGINE_SECRET=your_sightengine_secret

# ── Hugging Face API (https://huggingface.co) ──────────
# Gratuit : 1 000 requêtes/jour
# Créer un compte → Settings → Access Tokens → New token
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Flask Secret Key ───────────────────────────────────
# Changez cette valeur en production
SECRET_KEY=sentinelle_supptic_groupe2_2025